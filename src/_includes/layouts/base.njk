<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + settings.site_name) if title else (settings.site_name + " | " + settings.owner_name) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ description or settings.meta_description }}">
<link rel="canonical" href="{{ settings.site_url | trimSlash }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ description or settings.meta_description }}">
<meta property="og:url" content="{{ settings.site_url | trimSlash }}{{ page.url }}">
{%- if settings.images.social_share %}
<meta property="og:image" content="{{ settings.site_url | trimSlash }}{{ settings.images.social_share }}">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<meta name="theme-color" content="#F5EFE4">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
<script src="/assets/js/site.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="brand-name">{{ settings.site_name }}</span>
      <span class="brand-sub">{{ settings.owner_name }}</span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <a href="/about/"{% if nav == "about" %} aria-current="page"{% endif %}>About</a>
      <a href="/speaking/"{% if nav == "speaking" %} aria-current="page"{% endif %}>Speaking &amp; Training</a>
      <a href="/writing/"{% if nav == "writing" %} aria-current="page"{% endif %}>Writing &amp; Media</a>
      <a href="/contact/"{% if nav == "contact" %} aria-current="page"{% endif %}>Contact</a>
      <a class="btn btn-primary" href="/#subscribe">Subscribe</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="brand-name">{{ settings.site_name }}</span>
        <span class="muted">{{ settings.tagline }}</span>
        <a href="mailto:{{ settings.contact_email }}" style="font-weight:500;text-decoration:none">{{ settings.contact_email }}</a>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <strong>Explore</strong>
          <a href="/about/">About</a>
          <a href="/speaking/">Speaking &amp; Training</a>
          <a href="/writing/">Writing &amp; Media</a>
          <a href="/contact/">Contact</a>
        </div>
        <div class="footer-col">
          <strong>Follow</strong>
          <a href="{{ settings.social.facebook }}" rel="noopener" target="_blank">Facebook</a>
          <a href="{{ settings.social.instagram }}" rel="noopener" target="_blank">Instagram</a>
          <a href="{{ settings.social.substack }}" rel="noopener" target="_blank">Substack</a>
          <a href="{{ settings.social.youtube }}" rel="noopener" target="_blank">YouTube</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ "" | year }} {{ settings.owner_name }}. All rights reserved.</span>
      <span>{{ settings.footer_note }}</span>
    </div>
  </div>
</footer>
</body>
</html>
