---
layout: layouts/base.njk
title: Contact
nav: contact
permalink: /contact/
description: Invite Philip Dimka to speak or train, or get in touch about media and collaborations.
---
<section class="wrap page-intro" style="padding-bottom:0">
  <div class="contact-grid">
    <div class="stack" style="gap:26px">
      <span class="eyebrow">Contact</span>
      <h1>Let's <em class="hl">talk</em>.</h1>
      <p class="lead">{{ contact.intro | replace("{days}", settings.reply_days) }}</p>

      <div class="details">
        <div><span class="label">Email</span><a class="value" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></div>
        <div><span class="label">Based in</span><span class="value">{{ settings.location }}</span></div>
        <div><span class="label">Follow</span>
          <div class="socials">
            <a href="{{ settings.social.facebook }}" rel="noopener" target="_blank">Facebook</a>
            <a href="{{ settings.social.instagram }}" rel="noopener" target="_blank">Instagram</a>
            <a href="{{ settings.social.substack }}" rel="noopener" target="_blank">Substack</a>
            <a href="{{ settings.social.youtube }}" rel="noopener" target="_blank">YouTube</a>
          </div>
        </div>
      </div>

      <div class="panel panel-sand stack" style="gap:10px;padding:30px;border-radius:20px">
        <h2 style="font-size:26px;font-weight:600">{{ contact.therapy_title }}</h2>
        <p class="muted" style="font-size:16px">{{ contact.therapy_text }}</p>
        <a class="text-link" href="{{ settings.balm_url }}">Visit Balm Therapeutic Services →</a>
      </div>

      <p class="muted" style="font-size:15px"><strong style="color:var(--ink)">In an emergency:</strong> {{ contact.emergency_text }}</p>
    </div>

    <form class="card form" action="https://api.web3forms.com/submit" method="post" data-contact>
      <h2 style="font-size:32px;font-weight:600">Send a message</h2>
      <input type="hidden" name="access_key" value="{{ settings.web3forms_key }}">
      <input type="hidden" name="subject" value="New message from psychphidims.com">
      <input type="hidden" name="from_name" value="PsychPhiDims website">
      <input type="hidden" name="redirect" value="{{ settings.site_url | trimSlash }}/thanks/">
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="field-row">
        <div class="field"><label for="c-name">Full name</label><input class="input" id="c-name" name="name" type="text" autocomplete="name" required></div>
        <div class="field"><label for="c-email">Email</label><input class="input" id="c-email" name="email" type="email" autocomplete="email" required></div>
      </div>
      <div class="field-row">
        <div class="field"><label for="c-phone">Phone / WhatsApp <span class="opt">(optional)</span></label><input class="input" id="c-phone" name="phone" type="tel" autocomplete="tel"></div>
        <div class="field"><label for="c-org">Organisation <span class="opt">(optional)</span></label><input class="input" id="c-org" name="organisation" type="text" autocomplete="organization"></div>
      </div>
      <div class="field"><label for="c-type">What is this about?</label>
        <select class="select" id="c-type" name="enquiry_type">
          {%- for t in contact.enquiry_types %}<option>{{ t }}</option>{%- endfor %}
        </select>
      </div>
      <div class="field-row">
        <div class="field"><label for="c-date">Event date <span class="opt">(if any)</span></label><input class="input" id="c-date" name="event_date" type="text" placeholder="e.g. March 2027"></div>
        <div class="field"><label for="c-loc">Location or online</label><input class="input" id="c-loc" name="location" type="text"></div>
      </div>
      <div class="field"><label for="c-msg">Message</label><textarea class="textarea" id="c-msg" name="message" required></textarea></div>
      <div><button class="btn btn-primary" type="submit" style="min-height:56px;padding:0 34px">Send message</button></div>
      <p class="form-note" data-form-status role="status"></p>
    </form>
  </div>
</section>
